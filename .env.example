# Point the app at a real backend. Leave empty to use the built-in mock API.
# To run the real backend that ships with this project (real persistence + genuine
# real-time chat via Socket.IO), run `npm run dev:full` and set this to:
# VITE_API_URL=http://localhost:4001/api
VITE_API_URL=
# Set to "false" to disable the mock API even if VITE_API_URL is empty.
VITE_USE_MOCK=true
